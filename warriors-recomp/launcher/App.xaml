<Application x:Class="WarriorsLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <!-- The Warriors: night asphalt, jersey yellow, vest red. Not purple, not cream. -->
    <SolidColorBrush x:Key="Bg" Color="#070708"/>
    <SolidColorBrush x:Key="Panel" Color="#121214"/>
    <SolidColorBrush x:Key="Side" Color="#0A0A0C"/>
    <SolidColorBrush x:Key="Line" Color="#2C2C30"/>
    <SolidColorBrush x:Key="Bone" Color="#F2F0EA"/>
    <SolidColorBrush x:Key="Mute" Color="#8B8680"/>
    <SolidColorBrush x:Key="Jersey" Color="#FFD100"/>
    <SolidColorBrush x:Key="JerseyHot" Color="#FFE566"/>
    <SolidColorBrush x:Key="JerseyDim" Color="#5C4A00"/>
    <SolidColorBrush x:Key="VestRed" Color="#C8102E"/>
    <SolidColorBrush x:Key="VestRedDim" Color="#6B0A18"/>
    <SolidColorBrush x:Key="Ink" Color="#0A0A0A"/>
    <!-- aliases used by older markup -->
    <SolidColorBrush x:Key="Brass" Color="#FFD100"/>
    <SolidColorBrush x:Key="BrassDim" Color="#5C4A00"/>

    <Style TargetType="Window">
      <Setter Property="Background" Value="{StaticResource Bg}"/>
      <Setter Property="Foreground" Value="{StaticResource Bone}"/>
      <Setter Property="FontFamily" Value="Bahnschrift, Segoe UI"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style x:Key="NavBtn" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Mute}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="18,14"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                    BorderBrush="{StaticResource Jersey}" BorderThickness="0">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#16140C"/>
                <Setter Property="Foreground" Value="{StaticResource Jersey}"/>
              </Trigger>
              <Trigger Property="Tag" Value="active">
                <Setter TargetName="bd" Property="BorderThickness" Value="3,0,0,0"/>
                <Setter TargetName="bd" Property="Background" Value="#1A1608"/>
                <Setter Property="Foreground" Value="{StaticResource Jersey}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryBtn" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Jersey}"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="28,14"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource JerseyHot}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Background" Value="#2A2A2E"/>
                <Setter Property="Foreground" Value="#55555A"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GhostBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Bone}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Jersey}"/>
                <Setter Property="Foreground" Value="{StaticResource Jersey}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#0C0C0E"/>
      <Setter Property="Foreground" Value="{StaticResource Bone}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="CaretBrush" Value="{StaticResource Jersey}"/>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#0C0C0E"/>
      <Setter Property="Foreground" Value="{StaticResource Bone}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="MinHeight" Value="32"/>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Bone}"/>
      <Setter Property="Background" Value="#121214"/>
      <Setter Property="Padding" Value="8,6"/>
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True">
          <Setter Property="Background" Value="#2A2208"/>
          <Setter Property="Foreground" Value="{StaticResource Jersey}"/>
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#3A2E00"/>
          <Setter Property="Foreground" Value="{StaticResource Jersey}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Bone}"/>
      <Setter Property="Margin" Value="0,6,0,6"/>
    </Style>

    <Style TargetType="ProgressBar">
      <Setter Property="Foreground" Value="{StaticResource Jersey}"/>
      <Setter Property="Background" Value="#1A1A1E"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="26"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{StaticResource Jersey}"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="SectionSub" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{StaticResource Mute}"/>
      <Setter Property="Margin" Value="0,0,0,18"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource VestRed}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
  </Application.Resources>
</Application>
