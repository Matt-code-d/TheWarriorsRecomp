<Window x:Class="WarriorsLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="The Warriors"
        Width="1120" Height="740"
        MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="210"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Column="0" Grid.RowSpan="2" Background="{StaticResource Side}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="18,26,14,20">
          <Image Source="pack://application:,,,/Assets/thewarriorsrecompmin.png"
                 Stretch="Uniform" MaxWidth="168" HorizontalAlignment="Left"
                 RenderOptions.BitmapScalingMode="HighQuality"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="18,0,14,18">
          <Border Background="{StaticResource VestRed}" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,6">
            <TextBlock Text="XBOX → PC  RECOMP" Foreground="White" FontSize="10" FontWeight="Bold"/>
          </Border>
          <TextBlock x:Name="TxtVersion" Text="EUR · native recompilation" Foreground="{StaticResource Mute}" FontSize="11"/>
        </StackPanel>

        <StackPanel Margin="0,10,0,0">
          <Button x:Name="NavHome" Style="{StaticResource NavBtn}" Content="HOME" Click="Nav_Click" Tag="active"/>
          <Button x:Name="NavVideo" Style="{StaticResource NavBtn}" Content="VIDEO" Click="Nav_Click"/>
          <Button x:Name="NavControls" Style="{StaticResource NavBtn}" Content="CONTROLS" Click="Nav_Click"/>
          <Button x:Name="NavGame" Style="{StaticResource NavBtn}" Content="GAME" Click="Nav_Click"/>
          <Button x:Name="NavAdvanced" Style="{StaticResource NavBtn}" Content="ADVANCED" Click="Nav_Click"/>
          <Button x:Name="NavAbout" Style="{StaticResource NavBtn}" Content="ABOUT" Click="Nav_Click"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" Grid.Row="0" Margin="36,28,36,8">

      <!-- HOME: title clip bg; first-setup OR quick settings -->
      <Grid x:Name="PanelHome" Visibility="Visible">
        <Image x:Name="ImgHomeBg" Stretch="UniformToFill" Opacity="0.42" IsHitTestVisible="False"
               RenderOptions.BitmapScalingMode="HighQuality"/>
        <Border Background="#990B0B0C" IsHitTestVisible="False"/>

        <!-- First launch: install dump before any settings -->
        <Border x:Name="HomeSetupDock" Background="#E00B0B0C" VerticalAlignment="Bottom" Margin="0,0,0,4" Padding="16,14"
                Visibility="Collapsed">
          <StackPanel>
            <TextBlock x:Name="LblHomeSetup" Text="FIRST SETUP" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
            <TextBlock x:Name="LblHomeSetupSub" Style="{StaticResource SectionSub}" Margin="0,0,0,12"
                       Text="Bring your own legally owned European disc image, then install it into assets."/>
            <TextBlock x:Name="LblHomeIsoPath" Style="{StaticResource FieldLabel}" Text="Disc image"/>
            <TextBox x:Name="TxtIsoHome" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Button x:Name="BtnBrowseIsoHome" Style="{StaticResource GhostBtn}" Content="Choose the ISO…" Padding="16,8" Click="BrowseIso_Click"/>
              <Button x:Name="BtnInstallHome" Style="{StaticResource PrimaryBtn}" Content="Install into assets" Margin="10,0,0,0" Padding="16,8" Click="Install_Click"/>
            </StackPanel>
            <CheckBox x:Name="ChkExtractHome" Content="Also extract with extract-xiso (optional)" Margin="0,0,0,8"/>
            <ProgressBar x:Name="BarInstallHome" Height="8" Margin="0,0,0,6" Minimum="0" Maximum="1" Value="0"/>
            <TextBlock x:Name="TxtInstallDetailHome" Foreground="{StaticResource Mute}" FontSize="12" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <DockPanel x:Name="HomeQuickDock" LastChildFill="False">
          <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,4"
                      Background="#E00B0B0C">
            <TextBlock x:Name="LblHomeQuick" Text="QUICK SETTINGS" Style="{StaticResource FieldLabel}" Margin="12,10,12,2"/>
            <TextBlock x:Name="LblHomeSub" Style="{StaticResource SectionSub}" Margin="12,0,12,8"
                       Text="How the game is shown: the window, the 3D resolution and the frame rate."/>
            <UniformGrid Columns="2" Rows="3" Margin="12,0,12,10">
              <StackPanel Margin="0,0,28,8">
                <TextBlock x:Name="LblHomeDisplay" Style="{StaticResource FieldLabel}" Text="Display mode"/>
                <ComboBox x:Name="CmbDisplayMode" DisplayMemberPath="Label" SelectionChanged="Settings_Changed"/>
              </StackPanel>
              <StackPanel Margin="0,0,0,8">
                <TextBlock x:Name="LblHomeWindow" Style="{StaticResource FieldLabel}" Text="Window size"/>
                <ComboBox x:Name="CmbResolution" DisplayMemberPath="Label" SelectionChanged="Settings_Changed"/>
              </StackPanel>
              <StackPanel Margin="0,0,28,8">
                <TextBlock x:Name="LblHomeRender" Style="{StaticResource FieldLabel}" Text="Render resolution"/>
                <ComboBox x:Name="CmbRenderScale" DisplayMemberPath="Label" SelectionChanged="Settings_Changed"/>
              </StackPanel>
              <StackPanel Margin="0,0,0,8">
                <TextBlock x:Name="LblHomeFpsCounter" Style="{StaticResource FieldLabel}" Text="FPS counter"/>
                <ComboBox x:Name="CmbPerfOverlay" DisplayMemberPath="Label" SelectionChanged="Settings_Changed"/>
              </StackPanel>
              <StackPanel Margin="0,0,28,0">
                <TextBlock x:Name="LblHomeFps" Style="{StaticResource FieldLabel}" Text="Frame rate"/>
                <ComboBox x:Name="CmbFps" DisplayMemberPath="Label" SelectionChanged="Settings_Changed"/>
              </StackPanel>
              <StackPanel>
                <TextBlock x:Name="LblHomeVSync" Style="{StaticResource FieldLabel}" Text="VSync"/>
                <CheckBox x:Name="ChkVSync" Content="VSync" Margin="0,6,0,0" Checked="Settings_Changed" Unchecked="Settings_Changed"/>
              </StackPanel>
            </UniformGrid>
          </StackPanel>
        </DockPanel>
      </Grid>

      <!-- VIDEO — reference ImGui: section headers + rows (label | control | grey hint) -->
      <DockPanel x:Name="PanelVideo" Visibility="Collapsed">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock x:Name="LblVideoTitle" Style="{StaticResource SectionTitle}" Text="VIDEO"/>
          <TextBlock x:Name="LblVideoSub" Style="{StaticResource SectionSub}"
                     Text="How the game is shown: the window, the 3D resolution and the frame rate."/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock x:Name="LblPresetSec" Text="GRAPHICS PRESET" Style="{StaticResource FieldLabel}"/>
            <TextBlock x:Name="TxtGpuDetect" Margin="0,0,0,8" Foreground="{StaticResource Mute}" FontSize="12" TextWrapping="Wrap"
                       Text="Detecting GPU…"/>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="LblVidPreset" Style="{StaticResource FieldLabel}" Text="Preset" VerticalAlignment="Center"/>
              <ComboBox x:Name="CmbGraphicsPreset" Grid.Column="1" DisplayMemberPath="Label" SelectionChanged="GraphicsPreset_Changed"/>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <Button x:Name="BtnApplyRecommended" Content="Use recommended" Padding="10,4" Click="ApplyRecommended_Click"/>
                <TextBlock x:Name="HintVidPreset" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Mute}" FontSize="12" TextWrapping="Wrap"
                           Text="Bundles upscaler, filmic and filtering for your GPU tier."/>
              </StackPanel>
            </Grid>

            <TextBlock x:Name="LblDisplaySec" Text="DISPLAY" Style="{StaticResource FieldLabel}"/>

            <Grid Margin="0,0,0,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="LblVidDisplayMode" Style="{StaticResource FieldLabel}" Text="Display mode" VerticalAlignment="Center"/>
              <ComboBox x:Name="CmbDisplayModeVideo" Grid.Column="1" DisplayMemberPath="Label" SelectionChanged="MirrorDisplay_Changed"/>
              <TextBlock Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Mute}" FontSize="12" TextWrapping="Wrap"
                         x:Name="HintVidDisplay" Text="Borderless fills the screen and switches instantly."/>
            </Grid>
            <Grid Margin="0,0,0,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="LblVidWindow" Style="{StaticResource FieldLabel}" Text="Window size" VerticalAlignment="Center"/>
              <ComboBox x:Name="CmbResolutionVideo" Grid.Column="1" DisplayMemberPath="Label" SelectionChanged="MirrorRes_Changed"/>
              <TextBlock Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Mute}" FontSize="12" x:Name="HintVidWindow" Text="Output size."/>
            </Grid>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="LblVidVSync" Style="{StaticResource FieldLabel}" Text="VSync" VerticalAlignment="Center"/>
              <CheckBox x:Name="ChkVSyncVideo" Grid.Column="1" Content="On" VerticalAlignment="Center" Checked="MirrorVSync_Changed" Unchecked="MirrorVSync_Changed"/>
              <TextBlock Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Mute}" FontSize="12" TextWrapping="Wrap"
                         x:Name="HintVidVSync" Text="Turn VSync off for rates above your monitor's."/>
            </Grid>

            <TextBlock x:Name="LblRenderSec" Text="RENDERING" Style="{StaticResource FieldLabel}"/>

            <Grid Margin="0,0,0,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="LblVidApi" Style="{StaticResource FieldLabel}" Text="Graphics API" VerticalAlignment="Center"/>
              <ComboBox x:Name="CmbApi" Grid.Column="1" DisplayMemberPath="Label" SelectionChanged="Settings_Changed"/>
              <TextBlock Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Mute}" FontSize="12" x:Name="HintVidApi" Text="D3D12 only for now. Vulkan is disabled."/>
            </Grid>
            <Grid Margin="0,0,0,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="LblVidRender" Style="{StaticResource FieldLabel}" Text="Resolution" VerticalAlignment="Center"/>
              <ComboBox x:Name="CmbRenderScaleVideo" Grid.Column="1" DisplayMemberPath="Label" SelectionChanged="MirrorRender_Changed"/>
              <TextBlock Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Mute}" FontSize="12" TextWrapping="Wrap"
                         x:Name="HintVidRender" Text="The frame's height. Match the window = 100%."/>
            </Grid>
            <Grid Margin="0,0,0,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="LblVidUpscaler" Style="{StaticResource FieldLabel}" Text="Upscaler" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ComboBox x:Name="CmbUpscaler" Width="170" DisplayMemberPath="Label" SelectionChanged="Upscaler_Changed"/>
                <ComboBox x:Name="CmbUpscaleQuality" Width="140" Margin="8,0,0,0" DisplayMemberPath="Label" SelectionChanged="Upscaler_Changed"/>
              </StackPanel>
              <TextBlock Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Mute}" FontSize="12" TextWrapping="Wrap"
                         x:Name="HintVidUpscaler" Text="AMD FSR / DLSS / XeSS. This host runs FSR 1.0; others fall back until wired."/>
            </Grid>
            <Grid Margin="0,0,0,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="LblVidAniso" Style="{StaticResource FieldLabel}" Text="Texture filtering" VerticalAlignment="Center"/>
              <ComboBox x:Name="CmbAniso" Grid.Column="1" DisplayMemberPath="Label" SelectionChanged="Settings_Changed"/>
              <TextBlock Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Mute}" FontSize="12" x:Name="HintVidAniso" Text="Anisotropic filtering keeps far-off ground sharp."/>
            </Grid>
            <Grid Margin="0,0,0,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="LblVidFps" Style="{StaticResource FieldLabel}" Text="Frame rate" VerticalAlignment="Center"/>
              <ComboBox x:Name="CmbFpsVideo" Grid.Column="1" DisplayMemberPath="Label" SelectionChanged="MirrorFps_Changed"/>
              <TextBlock Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Mute}" FontSize="12" TextWrapping="Wrap"
                         x:Name="HintVidFps" Text="The game runs every frame natively at this rate."/>
            </Grid>
            <Grid Margin="0,0,0,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="LblVidFrameGen" Style="{StaticResource FieldLabel}" Text="Frame generation" VerticalAlignment="Center"/>
              <ComboBox x:Name="CmbFrameGen" Grid.Column="1" DisplayMemberPath="Label" SelectionChanged="Settings_Changed"/>
              <TextBlock Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Mute}" FontSize="12" TextWrapping="Wrap"
                         x:Name="HintVidFrameGen" Text="Generated frames between the game's own. Not in this host yet."/>
            </Grid>
            <Grid Margin="0,0,0,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="LblVidDlss" Style="{StaticResource FieldLabel}" Text="DLSS model" VerticalAlignment="Center"/>
              <ComboBox x:Name="CmbDlssPreset" Grid.Column="1" DisplayMemberPath="Label" SelectionChanged="Settings_Changed"/>
              <TextBlock Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Mute}" FontSize="12" x:Name="HintVidDlss" Text="Which DLSS model runs."/>
            </Grid>
            <Grid Margin="0,0,0,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="LblVidSharp" Style="{StaticResource FieldLabel}" Text="Sharpness" VerticalAlignment="Center"/>
              <DockPanel Grid.Column="1">
                <TextBlock x:Name="TxtSharpnessVal" DockPanel.Dock="Right" Width="36" Text="20" VerticalAlignment="Center" Foreground="{StaticResource Mute}"/>
                <Slider x:Name="SldSharpness" Minimum="0" Maximum="100" Value="20" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Sharpness_Changed"/>
              </DockPanel>
            </Grid>

            <TextBlock Text="LOOK &amp; AUDIO" Style="{StaticResource FieldLabel}" Margin="0,12,0,0"/>
            <CheckBox x:Name="ChkFilmic" Content="Filmic look (opt-in)" Margin="0,4,0,0" Checked="Settings_Changed" Unchecked="Settings_Changed"/>
            <Grid Margin="0,4,0,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource FieldLabel}" Text="Filmic strength" VerticalAlignment="Center"/>
              <DockPanel Grid.Column="1">
                <TextBlock x:Name="TxtFilmicStrVal" DockPanel.Dock="Right" Width="36" Text="50" VerticalAlignment="Center" Foreground="{StaticResource Mute}"/>
                <Slider x:Name="SldFilmicStrength" Minimum="0" Maximum="100" Value="50" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="FilmicSlider_Changed"/>
              </DockPanel>
            </Grid>
            <Grid Margin="0,0,0,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource FieldLabel}" Text="Vignette" VerticalAlignment="Center"/>
              <DockPanel Grid.Column="1">
                <TextBlock x:Name="TxtFilmicVigVal" DockPanel.Dock="Right" Width="36" Text="35" VerticalAlignment="Center" Foreground="{StaticResource Mute}"/>
                <Slider x:Name="SldFilmicVignette" Minimum="0" Maximum="100" Value="35" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="FilmicSlider_Changed"/>
              </DockPanel>
            </Grid>
            <Grid Margin="0,0,0,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource FieldLabel}" Text="Grain" VerticalAlignment="Center"/>
              <DockPanel Grid.Column="1">
                <TextBlock x:Name="TxtFilmicGrainVal" DockPanel.Dock="Right" Width="36" Text="0" VerticalAlignment="Center" Foreground="{StaticResource Mute}"/>
                <Slider x:Name="SldFilmicGrain" Minimum="0" Maximum="100" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="FilmicSlider_Changed"/>
              </DockPanel>
            </Grid>
            <CheckBox x:Name="ChkSceneGlow" Content="Scene glow (bright bloom, opt-in)" Margin="0,4,0,0" Checked="Settings_Changed" Unchecked="Settings_Changed"/>
            <Grid Margin="0,4,0,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource FieldLabel}" Text="Glow strength" VerticalAlignment="Center"/>
              <DockPanel Grid.Column="1">
                <TextBlock x:Name="TxtGlowVal" DockPanel.Dock="Right" Width="36" Text="40" VerticalAlignment="Center" Foreground="{StaticResource Mute}"/>
                <Slider x:Name="SldSceneGlow" Minimum="0" Maximum="100" Value="40" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="FilmicSlider_Changed"/>
              </DockPanel>
            </Grid>
            <Grid Margin="0,0,0,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource FieldLabel}" Text="Audio resampler" VerticalAlignment="Center"/>
              <ComboBox x:Name="CmbAudioResampler" Grid.Column="1" DisplayMemberPath="Label" SelectionChanged="Settings_Changed"/>
              <TextBlock Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Mute}" FontSize="12" TextWrapping="Wrap"
                         Text="linear = baseline. hq = Hermite (cleaner highs)."/>
            </Grid>
            <CheckBox x:Name="ChkPipelineCache" Content="Shader pipeline cache" Margin="0,4,0,0" IsChecked="True" Checked="Settings_Changed" Unchecked="Settings_Changed"/>
            <CheckBox x:Name="ChkGpuSkinning" Content="GPU vertex programs (already on)" Margin="0,4,0,0" IsChecked="True" Checked="Settings_Changed" Unchecked="Settings_Changed"/>

            <CheckBox x:Name="ChkCustomTex" Content="Custom textures" Margin="0,8,0,0" Checked="Settings_Changed" Unchecked="Settings_Changed"/>
            <TextBlock x:Name="TxtRenderHint" Margin="0,12,0,0" Foreground="{StaticResource Mute}" TextWrapping="Wrap"/>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>

      <!-- CONTROLS -->
      <DockPanel x:Name="PanelControls" Visibility="Collapsed">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock x:Name="LblControlsTitle" Style="{StaticResource SectionTitle}" Text="CONTROLS"/>
          <TextBlock x:Name="LblControlsSub" Style="{StaticResource SectionSub}"
                     Text="Keyboard, mouse and controller all work together; whichever you use answers."/>
        </StackPanel>
        <StackPanel>
          <TextBlock x:Name="LblCtrlGeneral" Text="GENERAL" Style="{StaticResource FieldLabel}"/>
          <CheckBox x:Name="ChkKeyboard" Content="Keyboard and mouse" Checked="Settings_Changed" Unchecked="Settings_Changed"/>
          <CheckBox x:Name="ChkInvertY" Content="Invert camera Y" Checked="Settings_Changed" Unchecked="Settings_Changed"/>
          <CheckBox x:Name="ChkVibration" Content="Vibration" Checked="Settings_Changed" Unchecked="Settings_Changed"/>
          <TextBlock x:Name="LblCtrlKb" Text="KEYBOARD AND MOUSE" Style="{StaticResource FieldLabel}" Margin="0,20,0,0"/>
          <TextBlock x:Name="LblControlsHint" Foreground="{StaticResource Mute}" TextWrapping="Wrap" FontSize="12"
                     Text="Full remapping ships in a later build. Flags above are written to settings.toml (same keys as the reference)."/>
        </StackPanel>
      </DockPanel>

      <!-- GAME: LANGUAGE / YOUR GAME / LAUNCHER -->
      <DockPanel x:Name="PanelGame" Visibility="Collapsed">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock x:Name="LblGameTitle" Style="{StaticResource SectionTitle}" Text="GAME"/>
          <TextBlock x:Name="LblGameSub" Style="{StaticResource SectionSub}"
                     Text="Your copy of the game, its language and the launcher itself."/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock x:Name="LblLangSec" Text="LANGUAGE" Style="{StaticResource FieldLabel}"/>
            <Grid Margin="0,0,0,18">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <ComboBox x:Name="CmbLanguage" DisplayMemberPath="DisplayName" SelectionChanged="Language_Changed"/>
              <TextBlock Grid.Column="1" x:Name="LblLangNote" Margin="16,0,0,0" VerticalAlignment="Center"
                         Foreground="{StaticResource Mute}" TextWrapping="Wrap"
                         Text="English is the standard. Others play where your disc has them. The launcher UI follows this language."/>
            </Grid>

            <TextBlock x:Name="LblYourGameSec" Text="YOUR GAME" Style="{StaticResource FieldLabel}"/>
            <TextBlock x:Name="LblIsoPath" Style="{StaticResource FieldLabel}" Text="Disc image"/>
            <TextBox x:Name="TxtIso" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Button x:Name="BtnBrowseIso" Style="{StaticResource GhostBtn}" Content="Choose the ISO…" Padding="16,8" Click="BrowseIso_Click"/>
              <Button x:Name="BtnInstall" Style="{StaticResource GhostBtn}" Content="Install into assets" Margin="10,0,0,0" Padding="16,8" Click="Install_Click"/>
              <Button x:Name="BtnOpenAssets" Style="{StaticResource GhostBtn}" Content="Open the game folder" Margin="10,0,0,0" Padding="16,8" Click="OpenAssets_Click"/>
            </StackPanel>
            <CheckBox x:Name="ChkExtract" Content="Also extract with extract-xiso (optional)" Margin="0,0,0,8"/>
            <ProgressBar x:Name="BarInstall" Height="8" Margin="0,0,0,6" Minimum="0" Maximum="1" Value="0"/>
            <TextBlock x:Name="TxtInstallDetail" Foreground="{StaticResource Mute}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,18"/>

            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12" Margin="0,8,0,0">
              <StackPanel>
                <TextBlock x:Name="LblBinary" Style="{StaticResource FieldLabel}" Text="Binary"/>
                <TextBlock x:Name="TxtExe" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                <TextBlock x:Name="LblAssets" Style="{StaticResource FieldLabel}" Text="Assets" Margin="0,8,0,4"/>
                <TextBlock x:Name="TxtAssets" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <TextBlock x:Name="TxtLangHint" Margin="0,12,0,0" Foreground="{StaticResource Mute}" TextWrapping="Wrap"/>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>

      <!-- ADVANCED -->
      <DockPanel x:Name="PanelAdvanced" Visibility="Collapsed">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock x:Name="LblAdvTitle" Style="{StaticResource SectionTitle}" Text="ADVANCED"/>
          <TextBlock x:Name="LblAdvSub" Style="{StaticResource SectionSub}" Text="The launcher's background, logs and folders."/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock x:Name="LblAdvVulkan" Text="VULKAN" Style="{StaticResource FieldLabel}"/>
            <TextBlock Foreground="{StaticResource Mute}" TextWrapping="Wrap" Margin="0,0,0,18" FontSize="12"
                       x:Name="TxtAdvVulkan" Text="Vulkan is disabled in this build. The host runs Direct3D 12 only."/>

            <TextBlock x:Name="LblAdvFiles" Text="FILES" Style="{StaticResource FieldLabel}"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
              <Button Style="{StaticResource GhostBtn}" x:Name="BtnOpenLogs" Content="Open the logs folder" Padding="16,8" Click="OpenLogs_Click"/>
              <Button x:Name="BtnAdvOpenAssets" Style="{StaticResource GhostBtn}" Content="Open the game folder" Margin="10,0,0,0" Padding="16,8" Click="OpenAssets_Click"/>
              <Button Style="{StaticResource GhostBtn}" x:Name="BtnOpenPort" Content="Open port folder" Margin="10,0,0,0" Padding="16,8" Click="OpenPort_Click"/>
            </StackPanel>

            <TextBlock x:Name="LblAdvUpscaler" Text="UPSCALER RUNTIME" Style="{StaticResource FieldLabel}"/>
            <TextBlock x:Name="TxtUpscalerStatus" Foreground="{StaticResource Bone}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <Button Style="{StaticResource GhostBtn}" x:Name="BtnRefreshDll" Content="Refresh DLL status" HorizontalAlignment="Left" Padding="16,8" Click="RefreshAdvanced_Click"/>

            <TextBlock x:Name="LblAdvInGame" Text="IN GAME" Style="{StaticResource FieldLabel}" Margin="0,18,0,0"/>
            <TextBlock Foreground="{StaticResource Mute}" FontSize="12" TextWrapping="Wrap"
                       x:Name="TxtAdvInGame" Text="F10 toggles the performance overlay setting."/>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>

      <!-- ABOUT -->
      <DockPanel x:Name="PanelAbout" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock x:Name="LblAboutTitle" Style="{StaticResource SectionTitle}" Text="ABOUT"/>
            <TextBlock x:Name="LblAboutHow" Text="HOW IT WORKS" Style="{StaticResource FieldLabel}" Margin="0,8,0,0"/>
            <TextBlock x:Name="LblAboutBody" Foreground="{StaticResource Bone}" TextWrapping="Wrap" FontSize="13" LineHeight="20" Margin="0,0,0,16"
                       Text="The game's Xbox code is statically recompiled into native x64 code (XboxXBERecomp). Graphics, sound and system calls are reimplemented for Windows (Direct3D 12, XAudio2). Nothing from the game ships with the port."/>
            <TextBlock x:Name="LblAboutCredits" Text="CREDITS" Style="{StaticResource FieldLabel}"/>
            <TextBlock Foreground="{StaticResource Mute}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,16"
                       x:Name="TxtAboutCredits" Text=""/>
            <TextBlock x:Name="LblAboutLegal" Text="LEGAL" Style="{StaticResource FieldLabel}"/>
            <TextBlock Foreground="{StaticResource Mute}" TextWrapping="Wrap" FontSize="12"
                       x:Name="TxtAboutLegal" Text="The Warriors is a trademark of its owners. This project is not affiliated with Rockstar Games, Take-Two Interactive or Paramount. Bring your own legally owned EUR dump. MIT covers only original repo work — see LICENSE."/>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Grid>

    <Border Grid.Column="1" Grid.Row="1" Background="{StaticResource Side}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="28,14,28,16">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" MaxWidth="520">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Fill="{StaticResource Ready}" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="TxtReady" Text="Ready to play." Foreground="{StaticResource Bone}" FontWeight="SemiBold"/>
          </StackPanel>
          <TextBlock x:Name="StatusInstall" Text="—" FontSize="11" Foreground="{StaticResource Mute}" Margin="16,4,0,0"/>
          <TextBlock x:Name="StatusLang" Text="" FontSize="11" Foreground="{StaticResource Mute}" Margin="16,2,0,0"/>
          <TextBlock x:Name="TxtPlayMsg" FontSize="11" Foreground="{StaticResource Brass}" Margin="16,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="BtnSave" Style="{StaticResource GhostBtn}" Content="Save" Width="110" Click="Save_Click" Margin="0,0,12,0"/>
          <Button x:Name="BtnPlay" Style="{StaticResource PrimaryBtn}" Content="PLAY" Width="150" Click="Play_Click"/>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
